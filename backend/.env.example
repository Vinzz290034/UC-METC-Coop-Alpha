# Copy to backend/.env and fill in values (never commit .env)

NODE_ENV=development
PORT=5000

# Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uc_coop
DB_USER=postgres
DB_PASSWORD=postgres

# Render / Railway / Neon (production — overrides DB_* when set)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

JWT_SECRET=change-me-use-openssl-rand-base64-48
JWT_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Gmail
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# Or SendGrid
# EMAIL_SERVICE=SendGrid
# EMAIL_USER=apikey
# EMAIL_PASSWORD=SG.your-sendgrid-api-key
# EMAIL_FROM=your-verified-sender@gmail.com

# Or Generic SMTP (e.g. Brevo)
# EMAIL_SERVICE=custom
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-smtp-login-email-or-username
# EMAIL_PASSWORD=your-smtp-password-or-key
# EMAIL_FROM=no-reply@yourdomain.com
